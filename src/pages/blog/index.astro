---
import Layout from '../../layouts/Layout.astro';
import Heading from '../../components/Heading.astro';
import { getCollection } from 'astro:content';
import { IconCalendar, IconTag, IconArrowRight } from '@tabler/icons-react';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = [...new Set(sortedPosts.flatMap(post => post.data.tags))];
---

<Layout title="Dev Blog">
  <section class="flex flex-col gap-8 py-6">
    <div class="flex flex-col gap-3">
      <Heading title="Dev Blog & Articles" textGradient size="h2" />
      <p class="text-xl text-slate-600 dark:text-slate-300">
        Thoughts, architectural deep dives, and lessons learned from building production AI systems and full-stack applications.
      </p>
    </div>

    <!-- Tags summary list -->
    {allTags.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 pt-2">
        <span class="flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          <IconTag size={16} /> Topics:
        </span>
        {allTags.map(tag => (
          <span class="rounded-full bg-slate-200 px-3 py-1 text-xs font-medium text-slate-800 transition-colors hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {sortedPosts.map(post => (
        <a
          href={`/blog/${post.id}/`}
          class="group flex flex-col justify-between rounded-xl border border-slate-200 bg-slate-50 p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-light-primary hover:shadow-lg dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-accent"
        >
          <div class="space-y-3">
            <div class="flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400">
              <IconCalendar size={16} />
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            </div>

            <h3 class="text-xl font-bold text-slate-900 transition-colors group-hover:text-light-primary dark:text-slate-100 dark:group-hover:text-accent">
              {post.data.title}
            </h3>

            <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">
              {post.data.description}
            </p>
          </div>

          <div class="mt-6 flex items-center justify-between border-t border-slate-200/80 pt-4 dark:border-slate-800/80">
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.slice(0, 3).map(tag => (
                <span class="rounded bg-slate-200/80 px-2 py-0.5 text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  {tag}
                </span>
              ))}
            </div>

            <span class="inline-flex items-center gap-1 text-sm font-semibold text-light-primary transition-transform group-hover:translate-x-1 dark:text-accent">
              Read article <IconArrowRight size={16} />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
